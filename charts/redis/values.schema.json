{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Helm Redis Chart Values Schema",
  "description": "Schema for validating values.yaml for the Redis Helm chart.",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string",
      "description": "Override the name of the chart (used in naming resources)",
      "default": ""
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name (default is the chart name + release name)",
      "default": ""
    },
    "redis": {
      "type": "object",
      "description": "Redis Configuration",
      "properties": {
        "config": {
          "type": "object",
          "description": "Configuration for mounting an existing Secret that contains a redis.conf file",
          "properties": {
            "secret": {
              "type": "object",
              "description": "Existing Secret reference",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the existing Secret containing the Redis configuration",
                  "default": ""
                },
                "key": {
                  "type": "string",
                  "description": "Key in the Secret that holds the redis.conf content",
                  "default": ""
                }
              }
            }
          }
        },
        "annotations": {
          "type": "object",
          "description": "Metadata annotations for the Redis deployment",
          "default": {}
        },
        "replicaCount": {
          "type": "integer",
          "description": "Number of replicas/pods to run (should typically be 1)",
          "minimum": 1,
          "default": 1
        },
        "containers": {
          "type": "object",
          "description": "Redis containers configuration",
          "properties": {
            "redis": {
              "type": "object",
              "description": "Redis container configuration",
              "properties": {
                "image": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "description": "Docker image repository for Redis",
                      "default": "redis"
                    },
                    "tag": {
                      "type": "string",
                      "description": "Image tag to use (leave empty to use default from Chart or latest)",
                      "default": ""
                    },
                    "pullPolicy": {
                      "type": "string",
                      "description": "Image pull policy (e.g., Always, IfNotPresent, Never)",
                      "default": "IfNotPresent",
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ]
                    }
                  },
                  "required": [
                    "repository",
                    "pullPolicy"
                  ]
                },
                "env": {
                  "type": "array",
                  "description": "Environment variables for Redis container",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ]
                  }
                },
                "resources": {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "object",
                      "properties": {
                        "memory": {
                          "type": "string",
                          "description": "Minimum amount of memory requested for the Redis container",
                          "default": "512Mi"
                        }
                      }
                    }
                  }
                },
                "volumeMounts": {
                  "type": "array",
                  "description": "Additional volume mounts for the Redis container",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "mountPath": {
                        "type": "string"
                      },
                      "subPath": {
                        "type": "string"
                      }
                    }
                  }
                },
                "port": {
                  "type": "integer",
                  "description": "Default port for the Redis service",
                  "default": 6379
                }
              },
              "required": [
                "image",
                "port"
              ]
            }
          },
          "required": [
            "redis"
          ]
        },
        "hostname": {
          "type": "string",
          "description": "Hostname used for the Redis pod/container",
          "default": ""
        },
        "volumes": {
          "type": "array",
          "description": "Additional volumes to be mounted into the Redis pod",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "persistentVolumeClaim": {
                "type": "object",
                "properties": {
                  "claimName": {
                    "type": "string"
                  }
                },
                "required": [
                  "claimName"
                ]
              },
              "secret": {
                "type": "object",
                "properties": {
                  "secretName": {
                    "type": "string"
                  }
                },
                "required": [
                  "secretName"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "services": {
          "type": "array",
          "description": "Configuration for the Kubernetes Services exposing Redis",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Optional suffix for the service name"
              },
              "type": {
                "type": "string",
                "description": "Kubernetes service type (e.g., ClusterIP, NodePort, LoadBalancer)",
                "enum": [
                  "ClusterIP",
                  "NodePort",
                  "LoadBalancer"
                ]
              },
              "ports": {
                "type": "array",
                "description": "List of ports to expose via the service.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "targetPort": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "TCP",
                        "UDP"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "port",
                    "targetPort",
                    "protocol"
                  ]
                }
              }
            },
            "required": [
              "type",
              "ports"
            ]
          }
        }
      },
      "required": [
        "containers"
      ]
    }
  },
  "required": [
    "redis"
  ]
}
